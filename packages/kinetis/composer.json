{
    "name": "kinetis/kinetis",
    "description": "The Runtime-Aware PHP Framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpstan/phpstan": "^2.2",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "revolt/event-loop": "^1.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\": "src/"
        },
        "files": [
            "src/Async/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kinetis"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
