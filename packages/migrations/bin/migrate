#!/usr/bin/env php
<?php

declare(strict_types=1);

use Kinetis\Config\Config;
use Kinetis\Config\EnvFile;
use Kinetis\Migrations\MigrationRunner;
use Kinetis\Migrations\MigrationScaffolder;
use Kinetis\Migrations\SqlMigrationRepository;
use Kinetis\Persistence\SqlConnectionFactory;
use Kinetis\Runtime\ProjectRoot;

// Same Composer bin-proxy handling as kinetis/kinetis's own bin/kinetis —
// once installed as a dependency, this runs through a generated
// vendor/bin/migrate proxy that sets these globals before including this
// script, so dirname(__DIR__) alone would resolve to this package's own
// directory, not the consumer project's.
if (isset($GLOBALS['_composer_autoload_path'])) {
    $autoloadPath = $GLOBALS['_composer_autoload_path'];
    unset($GLOBALS['_composer_autoload_path']);
} else {
    $autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';
}

require $autoloadPath;

$projectRoot = ProjectRoot::detect(__DIR__);
EnvFile::safeLoad($projectRoot);
$migrationsPath = $projectRoot . '/migrations';

$command = $argv[1] ?? null;

if ($command === 'make') {
    $description = $argv[2] ?? null;

    if ($description === null) {
        fwrite(STDERR, "Usage: migrate make <description>\n");
        exit(1);
    }

    $path = MigrationScaffolder::create($migrationsPath, $description);
    fwrite(STDOUT, "Created {$path}\n");
    exit(0);
}

if (!in_array($command, ['migrate', 'rollback', 'status'], true)) {
    fwrite(STDERR, "Usage: migrate migrate|rollback|status|make <description>\n");
    exit(1);
}

$config = Config::fromEnvironment();

// MIGRATE_CONNECTION_NAME selects a named DB_* connection block (see
// Kinetis\Config\Config::scopedKey()) — 'default' reads plain DB_* keys.
$connectionName = $config->string('MIGRATE_CONNECTION_NAME', 'default');
$db = SqlConnectionFactory::fromConfig($config, $connectionName);

$runner = new MigrationRunner($db, new SqlMigrationRepository($db), $migrationsPath);

if ($command === 'migrate') {
    $applied = $runner->migrate();

    if ($applied === []) {
        fwrite(STDOUT, "Nothing to migrate.\n");
    } else {
        foreach ($applied as $name) {
            fwrite(STDOUT, "Migrated: {$name}\n");
        }
    }

    exit(0);
}

if ($command === 'rollback') {
    $name = $runner->rollback();
    fwrite(STDOUT, $name !== null ? "Rolled back: {$name}\n" : "Nothing to roll back.\n");
    exit(0);
}

// status
$status = $runner->status();

if ($status === []) {
    fwrite(STDOUT, "No migrations found.\n");
} else {
    foreach ($status as $entry) {
        $marker = $entry['applied'] ? '[applied]' : '[pending]';
        fwrite(STDOUT, "{$marker} {$entry['name']}\n");
    }
}

exit(0);
