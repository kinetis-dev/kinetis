{
    "name": "kinetis/pingpong",
    "description": "A runnable ping-pong demo application showcasing Kinetis: MySQL, migrations, the query builder, Redis-backed cache and queue, events, a cron-driven command, and real-time updates over Soketi.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "kinetis/migrations": "dev-main",
        "kinetis/persistence": "dev-main",
        "kinetis/cache-redis": "dev-main",
        "kinetis/query-builder": "dev-main",
        "kinetis/queue": "dev-main",
        "kinetis/mcp": "dev-main",
        "league/plates": "^3.6.0",
        "monolog/monolog": "^3.10.0",
        "psr/http-message": "^2.0",
        "pusher/pusher-php-server": "^7.3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../migrations"
        },
        {
            "type": "path",
            "url": "../persistence"
        },
        {
            "type": "path",
            "url": "../cache-redis"
        },
        {
            "type": "path",
            "url": "../query-builder"
        },
        {
            "type": "path",
            "url": "../queue"
        },
        {
            "type": "path",
            "url": "../mcp"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
