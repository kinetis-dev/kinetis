{
    "name": "kinetis/search",
    "description": "Engine-neutral search contracts for Kinetis: the single-origin, deadline-bounded, non-blocking HTTP transport an engine client is built on, and a narrow client interface over indexing, retrieval, deletion, search, and bulk.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "kinetis/revolt-http-client": "dev-main",
        "nyholm/psr7": "^1.8.2",
        "psr/http-client": "^1.0.3",
        "psr/http-message": "^2.0",
        "symfony/http-client-contracts": "^3.7.1"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "symfony/http-client": "^8.1.4",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Search\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../revolt-http-client"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
