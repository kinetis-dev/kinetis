{
    "name": "kinetis/mailer",
    "description": "Non-blocking mail sending for Kinetis — Symfony\\Component\\Mailer over any DSN-selected transport, with API-based transports going through kinetis/revolt-http-client instead of blocking.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "kinetis/revolt-http-client": "dev-main",
        "symfony/mailer": "^7.2|^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Mailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Mailer\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../revolt-http-client"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
