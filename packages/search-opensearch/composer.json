{
    "name": "kinetis/search-opensearch",
    "description": "Fiber-native non-blocking OpenSearch client construction for Kinetis, via kinetis/revolt-http-client's Revolt-backed HTTP transport.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/kinetis": "dev-main",
        "kinetis/revolt-http-client": "dev-main",
        "opensearch-project/opensearch-php": "^2.6",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\SearchOpenSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\SearchOpenSearch\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../kinetis"
        },
        {
            "type": "path",
            "url": "../revolt-http-client"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
