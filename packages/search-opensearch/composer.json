{
    "name": "kinetis/search-opensearch",
    "description": "Fiber-native non-blocking OpenSearch client construction for Kinetis, on kinetis/search's Revolt-backed HTTP transport.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "kinetis/search": "dev-main",
        "opensearch-project/opensearch-php": "^2.6.0",
        "psr/http-client": "^1.0.3"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/revolt-http-client": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\SearchOpenSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\SearchOpenSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "bootstrap": "Kinetis\\SearchOpenSearch\\PackageBootstrap"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../revolt-http-client"
        },
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
