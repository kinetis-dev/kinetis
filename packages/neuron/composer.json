{
    "name": "kinetis/neuron",
    "description": "Runs Neuron AI providers over kinetis/revolt-http-client: a non-blocking, origin-pinned, deadline- and byte-bounded HttpClientInterface for neuron-core/neuron-ai, safe to share across requests in a persistent worker. Usable standalone, not only with Kinetis.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/revolt-http-client": "dev-main",
        "neuron-core/neuron-ai": "^4.1.24"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/framework": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.3",
        "vimeo/psalm": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Neuron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Neuron\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../revolt-http-client"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
