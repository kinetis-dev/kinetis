{
    "name": "kinetis/neuron",
    "description": "Runs Neuron AI providers over kinetis/revolt-http-client: a non-blocking, origin-pinned, deadline- and byte-bounded HttpClientInterface for neuron-core/neuron-ai, safe to share across requests in a persistent worker, an Amazon Bedrock chat and embeddings provider over kinetis/aws-sigv4, and the application's own #[McpTool] tools as Neuron tools, called in process in the current request's scope.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/aws-sigv4": "dev-main",
        "kinetis/framework": "dev-main",
        "kinetis/mcp": "dev-main",
        "kinetis/mcp-protocol": "dev-main",
        "kinetis/revolt-http-client": "dev-main",
        "neuron-core/neuron-ai": "^4.1.27",
        "nyholm/psr7": "^1.8.2",
        "psr/http-client": "^1.0.3",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "nikic/php-parser": "^5.8.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.3",
        "vimeo/psalm": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Neuron\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Neuron\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../aws-sigv4"
        },
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../mcp"
        },
        {
            "type": "path",
            "url": "../mcp-protocol"
        },
        {
            "type": "path",
            "url": "../revolt-http-client"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
