{
    "name": "kinetis/framework",
    "description": "The Runtime-Aware PHP Framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "nyholm/psr7": "^1.8.2",
        "nyholm/psr7-server": "^1.1.0",
        "psr/container": "^2.0.2",
        "psr/event-dispatcher": "^1.0.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^3.0.2",
        "psr/simple-cache": "^3.0.0",
        "revolt/event-loop": "^1.0.9",
        "vlucas/phpdotenv": "^5.6.4"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "nikic/php-parser": "^5.8.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "suggest": {
        "ext-event": "An OS-native Revolt event-loop backend (epoll), removing select()'s 1024 fd-number ceiling. Needed when the loop watches real sockets (native Postgres driver, Redis, HTTP client) in a FrankenPHP worker process; a MySQL-only deployment does not need it. ext-uv/ext-ev work equally."
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\": "src/"
        },
        "files": [
            "src/Async/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kinetis"
    ],
    "extra": {
        "kinetis": {}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
