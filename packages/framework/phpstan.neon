parameters:
    level: 8
    # A compiled cache artifact's own PHPDoc shape is what a *correct*
    # build produces — never a guarantee about what's actually on disk. A
    # hand-edited, stale-version, or otherwise corrupted file is exactly
    # what ArtifactValidation and each section's own fromArray() exist to
    # catch, so the array_is_list()/is_array()/is_string() checks guarding
    # them are load-bearing runtime validation, not dead code PHPStan can
    # prove unreachable from the PHPDoc alone.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - bin/kinetis
        - public
    ignoreErrors:
        # Hydrator's plan cache is memoized *pure derived data* — identical
        # for a given DTO class on every request for the process lifetime —
        # so it cannot bleed request state, which is what the rule below
        # exists to prevent. See Hydrator's class docblock.
        -
            identifier: kinetis.noStaticProperties
            path: src/Validation/Hydrator.php
        # FiberPool's residents are worker-lifetime *infrastructure*, not
        # request state: the pool exists precisely so Fiber stacks outlive
        # a single request (per-task Fiber churn serializes ZTS threads on
        # the kernel address-space lock — see the class docblock), and a
        # static on a ZTS build is per-thread, matching the one-loop-per-
        # thread model. Jobs never park mid-task, so no request data can
        # ride along in an idle Fiber.
        -
            identifier: kinetis.noStaticProperties
            path: src/Async/FiberPool.php
        # Telemetry::global() is the same worker-lifetime-infrastructure
        # class of static as FiberPool's instance: the backend reference
        # is boot-time configuration, never request state, and it exists
        # because plain functions (concurrently()) and pre-container
        # lifecycle phases have no injection point at all. See the class
        # docblock.
        -
            identifier: kinetis.noStaticProperties
            path: src/Instrumentation/Telemetry.php
        # Socket::connect() opens its stream with STREAM_CLIENT_ASYNC_CONNECT
        # and a zero timeout, makes it non-blocking, and waits for the
        # connect and every read and write on Revolt watchers: it is the
        # suspending socket the blocking-call rule points application code
        # toward.
        -
            identifier: kinetis.blockingCall
            path: src/Async/Socket.php
        # ResponseSpec is conformance-suite test data. Its streamed body
        # pauses between chunks so the suite can time each chunk's arrival
        # on the wire, inside a fixture server answering that test request;
        # it never runs on an application's request path.
        -
            identifier: kinetis.blockingCall
            path: src/Testing/Runtime/ResponseSpec.php

services:
    -
        class: Kinetis\Linting\NoStaticPropertiesRule
        tags:
            - phpstan.rules.rule
    -
        class: Kinetis\Linting\NoBlockingIoRule
        tags:
            - phpstan.rules.rule
