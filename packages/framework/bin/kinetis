#!/usr/bin/env php
<?php

declare(strict_types=1);

use Kinetis\Cache\BootSequence;
use Kinetis\Cache\CacheStore;
use Kinetis\Cache\CompiledCache;
use Kinetis\Cache\Compiler;
use Kinetis\Config\Config;
use Kinetis\Config\EnvFile;
use Kinetis\Console\CommandDiscovery;
use Kinetis\Console\CommandDispatcher;
use Kinetis\Console\Events\CommandFailed;
use Kinetis\Container\AppScope;
use Kinetis\Container\TransactionGuardHook;
use Kinetis\Events\EventDispatcher;
use Kinetis\Events\EventListenerDiscovery;
use Kinetis\Logging\SafeLogger;
use Kinetis\Runtime\AppEnvironment;
use Kinetis\Runtime\ProjectRoot;
use Psr\Log\LoggerInterface;
use Psr\Log\LogLevel;

// Composer's generated vendor/bin/kinetis proxy sets this global before
// including this script, and that proxy is the entry point in any project
// that installed kinetis/framework. The bare path below resolves only
// inside this repository itself, where the CLI is developed — an
// installed dependency has no vendor/ of its own. Pattern taken from the
// real, vendored vendor/phpunit/phpunit/phpunit proxy script.
$autoloadPath = $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';
unset($GLOBALS['_composer_autoload_path']);

// Reached by running this file directly instead of through the proxy.
// Reported rather than left to require()'s own error, which names a path
// that cannot exist in an installed project and says nothing about the
// command to run instead.
if (!is_file($autoloadPath)) {
    fwrite(STDERR, "Cannot locate the Composer autoloader. Run vendor/bin/kinetis instead — "
        . "this script is not meant to be invoked directly.\n");

    exit(1);
}

require $autoloadPath;

$projectRoot = ProjectRoot::detect(__DIR__);

// Loaded before AppEnvironment::detect(): APP_ENV itself might be defined
// for the first time in .env, not already set in the real process
// environment.
EnvFile::safeLoad($projectRoot);

$env = AppEnvironment::detect();
$store = new CacheStore($projectRoot . '/.kinetis-cache');

// The entire job of this binary: in production, use the cache — auto-
// generating it on the first invocation that finds none, the same
// lazy-compile path public/index.php takes for HTTP; in development,
// always discover commands live from source. Every command this finds —
// including the built-in `build`/`mcp:serve` (Kinetis\Console\
// BuildCommand/McpServeCommand, discovered the same way as anything
// else) — goes through this exact same lookup, with no verb hardcoded
// here at all.
if ($env->isProduction()) {
    // BootSequence::resolveCli() is the entire "use the cache, or
    // compile fresh" decision: commands.php, events.php, and
    // plugins.php must all be present, the right format, and actually
    // reconstruct into live objects — CommandRegistry/
    // EventListenerRegistry/every plugin instance included, not just
    // the raw DTOs — or the whole generation is treated as absent and
    // $compile runs exactly once. See its own docblock. The OpenAPI
    // document is never part of this — it's generated/cached
    // separately, see docs/caching.md.
    $resolved = BootSequence::resolveCli($store, static fn (): CompiledCache => (new Compiler())->compileProject($projectRoot));

    $registry = $resolved['registry'];
    $listenerRegistry = $resolved['listenerRegistry'];
    $pluginInstances = $resolved['pluginInstances'];
    $packageBootstraps = $resolved['commandCache']->packageBootstraps;
} else {
    $registry = CommandDiscovery::discover($projectRoot);
    $listenerRegistry = EventListenerDiscovery::discover($projectRoot);
    // null = discover the package bootstrap list live, alongside the rest.
    $packageBootstraps = null;
    // Same sentinel BootSequence::run() reads as "discover and
    // reconstruct live".
    $pluginInstances = null;
}

$commandName = $argv[1] ?? null;
$definition = $commandName !== null ? $registry->findCommand($commandName) : null;

if ($definition === null) {
    if ($commandName === null) {
        fwrite(STDERR, "Usage: kinetis <command>\n\n");
    } else {
        fwrite(STDERR, "Unknown command \"{$commandName}\".\n\n");
    }

    fwrite(STDERR, "Available commands:\n");

    $commands = $registry->commands();

    // Width of the name column, so the descriptions line up whatever
    // commands the installed packages and the application contribute.
    $width = 0;

    foreach ($commands as $command) {
        $width = max($width, strlen($command->name));
    }

    foreach ($commands as $command) {
        $line = '  ' . ($command->description === ''
            ? $command->name
            : str_pad($command->name, $width) . '   ' . $command->description);

        fwrite(STDERR, $line . "\n");
    }

    exit(1);
}

$app = new AppScope();
$config = Config::fromEnvironment();
$app->instance(Config::class, $config);

// PluginDiscovery::bindInstances() and the discovered EventListenerRegistry
// both have to be bound before the bootstrap chain runs — see BootSequence's
// own docblock, the one place this ordering lives now, shared by
// public/index.php, TestApplication, and the reference copies in
// kinetis/skeleton/kinetis/pingpong. $runBootstrap: false for a
// #[Command(bootstrap: false)] command, which deliberately skips the
// whole package-then-application bootstrap chain — every installed
// package's own PackageBootstrapInterface::register() as well as the
// project's bootstrap.php, not just the latter — since it only operates
// on the project's static shape and must not require the configuration
// any of those registrations might demand (`kinetis build` in a CI
// pipeline has no database credentials, and needs none) — while still
// receiving the discovered/cached plugin and listener services
// unconditionally, the same as every other command.
BootSequence::run(
    $app,
    $projectRoot,
    $config,
    $listenerRegistry,
    $pluginInstances,
    $packageBootstraps,
    runBootstrap: $definition->bootstrap,
);
$app->boot();

$scope = $app->createRequestScope();
// The same shared safety net Kernel wires in for every HTTP request —
// see TransactionGuardHook's own docblock. Skipped alongside bootstrap:
// without the application's bindings there is no database link for the
// guard to resolve, and nothing to guard.
if ($definition->bootstrap) {
    TransactionGuardHook::registerIfAvailable($scope);
}

try {
    $exitCode = (new CommandDispatcher($scope))->run($definition, array_slice($argv ?? [], 2));
} catch (Throwable $e) {
    // logFrom(), not a direct $app->get(LoggerInterface::class)->error(...)
    // call: PHP would evaluate that get() call before entering any
    // containment at all, so a throwing LoggerInterface binding/factory
    // would escape uncaught right here and take exit(1) down with it —
    // see SafeLogger::logFrom()'s own docblock.
    SafeLogger::logFrom(
        fn (): LoggerInterface => $app->get(LoggerInterface::class),
        LogLevel::ERROR,
        "Command \"{commandName}\" failed: {message}",
        ['commandName' => $commandName, 'message' => $e->getMessage(), 'exception' => $e],
    );
    // $commandName is guaranteed a string here: $definition (resolved
    // above from $commandName) would already have triggered the earlier
    // exit(1) if $commandName were null.
    $scope->get(EventDispatcher::class)->dispatch(new CommandFailed($commandName, $e));
    $exitCode = 1;
}

// $scope->dispose() is deliberately outside the try/catch/finally above:
// a Throwable raised in a `finally` block silently replaces whatever
// exception or return value was already in flight, which would let a
// cleanup failure here either bypass the command's own intended exit(1)
// (the catch branch already ran, $exitCode is already decided) or turn
// a completed, successful command into an uncaught fatal outside this
// script's own error handling entirely. Neither is acceptable, so
// disposal is contained in its own try/catch instead, and its outcome
// never replaces $exitCode's own already-decided value except in the
// one case below where nothing was decided yet.
try {
    $scope->dispose();
} catch (Throwable $disposeFailure) {
    // $scope is already disposed by the time this runs, so the logger
    // is resolved from AppScope (still valid), not the scope itself.
    // logFrom(), not log(): a throwing LoggerInterface binding/factory
    // must be contained too, not just the resolved logger's own log()
    // call — see SafeLogger::logFrom()'s own docblock.
    SafeLogger::logFrom(
        fn (): LoggerInterface => $app->get(LoggerInterface::class),
        LogLevel::ERROR,
        "Request scope disposal failed after command \"{commandName}\" finished: {message}",
        ['commandName' => $commandName, 'message' => $disposeFailure->getMessage(), 'exception' => $disposeFailure],
    );

    if ($exitCode === 0) {
        // The command itself completed successfully — no exception, no
        // deliberate non-zero return — so there is nothing else already
        // signaling a problem. A cleanup failure means the unit of work
        // did not finish cleanly, though, so this cannot report a plain
        // 0 either. 70 is EX_SOFTWARE from BSD sysexits.h ("an internal
        // software error has been detected"), the deterministic,
        // documented non-zero code this script chooses for exactly this
        // case, kept distinct from the 1 a genuine command failure above
        // already produces and from any exit code a command's own logic
        // returns deliberately.
        $exitCode = 70;
    }
}

exit($exitCode);
