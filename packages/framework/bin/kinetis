#!/usr/bin/env php
<?php

declare(strict_types=1);

use Kinetis\Cache\CacheStore;
use Kinetis\Cache\Compiler;
use Kinetis\Cache\RoutesFile;
use Kinetis\Config\Config;
use Kinetis\Config\EnvFile;
use Kinetis\Console\CommandDiscovery;
use Kinetis\Console\CommandDispatcher;
use Kinetis\Console\CommandRegistry;
use Kinetis\Container\AppScope;
use Kinetis\Events\EventListenerDiscovery;
use Kinetis\Events\EventListenerRegistry;
use Kinetis\Runtime\AppEnvironment;
use Kinetis\Runtime\ProjectRoot;
use Psr\Log\LoggerInterface;

// Once installed as a dependency, this script runs through Composer's
// generated vendor/bin/kinetis proxy, which sets these globals before
// including the real target script — dirname(__DIR__) alone only resolves
// correctly when run directly against this repo's own root, not a real
// consumer install. Pattern taken from the real, vendored
// vendor/phpunit/phpunit/phpunit proxy script.
if (isset($GLOBALS['_composer_autoload_path'])) {
    $autoloadPath = $GLOBALS['_composer_autoload_path'];
    unset($GLOBALS['_composer_autoload_path']);
} else {
    $autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';
}

require $autoloadPath;

$projectRoot = ProjectRoot::detect(__DIR__);

// Loaded before AppEnvironment::detect(): APP_ENV itself might be defined
// for the first time in .env, not already set in the real process
// environment.
EnvFile::safeLoad($projectRoot);

$env = AppEnvironment::detect();
$store = new CacheStore($projectRoot . '/.kinetis-cache');

// The entire job of this binary: in production, use the cache — auto-
// generating it on the first invocation that finds none, the same
// lazy-compile path public/index.php takes for HTTP; in development,
// always discover commands live from source. Every command this finds —
// including the built-in `build`/`mcp:serve` (Kinetis\Console\
// BuildCommand/McpServeCommand, discovered the same way as anything
// else) — goes through this exact same lookup, with no verb hardcoded
// here at all.
if ($env->isProduction()) {
    $commandCache = $store->loadCommands();

    if ($commandCache === null) {
        // Nothing built yet: compile the whole project once (routes, MCP,
        // OpenAPI, commands, and event listeners together —
        // Compiler::compileProject()'s usual "compile everything in one
        // pass") and write it, so this and every subsequent
        // request/invocation has something to load.
        $compiled = (new Compiler())->compileProject($projectRoot);
        $store->writeAll($compiled);
        $commandCache = $compiled->commands;
        $eventCache = $compiled->events;
    } else {
        $eventCache = $store->loadEvents();
    }

    $registry = CommandRegistry::fromArray($commandCache->commands);
    // A confirmed nullsafe.neverNull false positive (see this file's twin
    // in public/index.php for the full explanation, verified there with
    // an isolated repro) — $eventCache is genuinely nullable via the
    // `else` branch above (CacheStore::loadEvents(): ?EventCache).
    $listenerRegistry = EventListenerRegistry::fromArray($eventCache?->listeners ?? []); // @phpstan-ignore nullsafe.neverNull
} else {
    $registry = CommandDiscovery::discover($projectRoot);
    $listenerRegistry = EventListenerDiscovery::discover($projectRoot);
}

$commandName = $argv[1] ?? null;
$definition = $commandName !== null ? $registry->findCommand($commandName) : null;

if ($definition === null) {
    if ($commandName === null) {
        fwrite(STDERR, "Usage: kinetis <command>\n\n");
    } else {
        fwrite(STDERR, "Unknown command \"{$commandName}\".\n\n");
    }

    fwrite(STDERR, "Available commands:\n");

    foreach ($registry->commands() as $command) {
        $line = "  {$command->name}";

        if ($command->description !== '') {
            $line .= " — {$command->description}";
        }

        fwrite(STDERR, $line . "\n");
    }

    exit(1);
}

$app = new AppScope();
$config = Config::fromEnvironment();
$app->instance(Config::class, $config);
// Consumer applications register anything a discovered command needs (a
// database connection pool, ...) in bootstrap.php — see public/index.php
// for the identical convention on the HTTP side.
RoutesFile::loadBootstrap($projectRoot)($app, $config);
$app->instance(EventListenerRegistry::class, $listenerRegistry);
$app->boot();

$scope = $app->createRequestScope();
// Same class_exists()-gated safety net Kernel wires in for every HTTP
// request — TransactionGuard lives in the separate, optional
// kinetis/persistence package, not core; a command opening a DB
// transaction and not closing it on every failure branch is exactly the
// scenario this exists for, when that package is actually installed.
if (class_exists('Kinetis\Persistence\TransactionGuard')) {
    $transactionGuard = $scope->get('Kinetis\Persistence\TransactionGuard');
    $scope->onDispose($transactionGuard->rollbackDangling(...));
}

try {
    $exitCode = (new CommandDispatcher($scope))->run($definition, array_slice($argv ?? [], 2));
} catch (Throwable $e) {
    $app->get(LoggerInterface::class)->error("Command \"{$commandName}\" failed: {$e->getMessage()}", ['exception' => $e]);
    $exitCode = 1;
} finally {
    $scope->dispose();
}

exit($exitCode);
