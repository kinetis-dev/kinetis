{
    "name": "kinetis/session",
    "description": "Cookie-backed sessions and CSRF protection for Kinetis — file, PSR-16 cache (Redis via kinetis/cache-redis), and SQL storage behind one store interface.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "psr/simple-cache": "^3.0.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0.2"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/cache-redis": "dev-main",
        "kinetis/persistence": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "suggest": {
        "kinetis/persistence": "Enables SqlSessionStore, sessions in a kinetis_sessions table over the SQL contracts.",
        "kinetis/cache-redis": "Redis-backed sessions with no further code: SESSION_DRIVER=cache stores through the PSR-16 binding cache-redis provides, cluster and TLS included."
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Session\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\Session\\Console\\",
            "bootstrap": "Kinetis\\Session\\PackageBootstrap"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../persistence"
        },
        {
            "type": "path",
            "url": "../cache-redis"
        },
        {
            "type": "path",
            "url": "../framework"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
