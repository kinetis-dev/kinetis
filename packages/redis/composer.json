{
    "name": "kinetis/redis",
    "description": "A non-replaying, deadline-bounded Redis transport for amphp/redis, with TLS, authentication, and Redis Cluster slot routing. Usable standalone, not only with Kinetis.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "amphp/amp": "^3.1.3",
        "amphp/redis": "^2.0.4",
        "amphp/socket": "^2.4.0",
        "revolt/event-loop": "^1.0.9"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/framework": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Redis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Redis\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
