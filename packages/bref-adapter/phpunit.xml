<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Kinetis\BrefAdapter">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!--
            BrefLambdaAdapter logs through error_log() — STDERR by
            default: handleEvent() writes a fixed line for a malformed
            request body on the way to its 400, and run() writes one
            type-only line for every invocation error. This suite
            exercises both paths. Infection's InitialTestsRunner stops
            the baseline PHPUnit run on the first byte it sees on STDERR,
            so those expected lines would kill every Infection run here. This redirect affects
            this PHPUnit run only; a real deployment's error_log()
            destination is its own runtime's business.
        -->
        <ini name="error_log" value="/dev/null"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
