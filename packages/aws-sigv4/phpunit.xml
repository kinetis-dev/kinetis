<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Kinetis\AwsSigV4">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Stack-trace arguments are what the failure-sentinel tests
             inspect for a leaked credential, header, or body; PHP's
             production ini drops them, so they are turned on here. -->
        <ini name="zend.exception_ignore_args" value="0"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
