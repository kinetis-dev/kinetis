{
    "name": "kinetis/mcp-docs",
    "description": "A standalone Model Context Protocol server exposing the Kinetis documentation as MCP resources over stdio, with one tool that returns a bounded line window of a page for a client that cannot take it whole. Framework-agnostic: it depends on kinetis/mcp-protocol alone and contributes no application bootstrap.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/mcp-protocol": "dev-main",
        "symfony/http-client": "^8.1.4",
        "symfony/http-client-contracts": "^3.7.1"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.3",
        "vimeo/psalm": "^6.17"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\McpDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\McpDocs\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kinetis-mcp-docs"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../mcp-protocol"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
