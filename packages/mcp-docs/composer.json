{
    "name": "kinetis/mcp-docs",
    "description": "A standalone Model Context Protocol server exposing the Kinetis documentation as MCP resources over stdio. Depends on no Kinetis package.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/http-client": "^8.1.4",
        "symfony/http-client-contracts": "^3.7.1"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\McpDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\McpDocs\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kinetis-mcp-docs"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
