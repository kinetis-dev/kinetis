{
    "name": "kinetis/tools",
    "description": "Internal monorepo build tooling — not a published package, no autoload of its own; generates and validates every packages/*/composer.json from packages.manifest.json.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Tools\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
